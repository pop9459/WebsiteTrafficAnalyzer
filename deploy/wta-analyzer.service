[Unit]
Description=Website traffic analyzer (KAP-60): Apache logs to dashboard JSON
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/personalWebsite
ExecStart=/usr/bin/docker compose -f docker-compose.yaml -f compose.kap60.yaml run --rm analyzer
# Stop a run that hangs; a normal run takes well under a minute.
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
SyslogIdentifier=wta-analyzer
